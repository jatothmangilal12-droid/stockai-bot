# StockAI Pro - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file with real credentials!

# Angel One SmartAPI Credentials
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Client IP for Angel One SmartAPI Whitelisting
# Set to your public IP or let backend auto-detect
CLIENT_PUBLIC_IP=

# Server Configuration
PORT=8000
HOST=0.0.0.0
